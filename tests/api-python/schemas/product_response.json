{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProductResponse",
  "description": "Response schema for GET /api/products/{id}",
  "type": "object",
  "required": ["id", "name", "stock", "price"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "stock": {
      "type": "integer",
      "minimum": 0
    },
    "price": {
      "type": ["number", "string"],
      "description": "Product price — may be returned as string or number depending on serialization"
    }
  },
  "additionalProperties": false
}
