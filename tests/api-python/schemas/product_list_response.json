{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProductListResponse",
  "description": "Response schema for GET /api/products",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "stock", "price"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "stock": {
        "type": "integer",
        "minimum": 0
      },
      "price": {
        "type": ["number", "string"]
      }
    },
    "additionalProperties": false
  }
}
