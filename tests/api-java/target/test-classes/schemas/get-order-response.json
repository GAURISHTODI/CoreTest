{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GetOrderResponse",
  "description": "Response schema for GET /api/orders/{id} (200 OK)",
  "type": "object",
  "required": ["id", "productId", "quantity", "status", "createdAt"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique order identifier"
    },
    "productId": {
      "type": "string",
      "format": "uuid",
      "description": "ID of the ordered product"
    },
    "quantity": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of units ordered"
    },
    "status": {
      "type": "string",
      "enum": ["PENDING", "CONFIRMED", "FAILED"],
      "description": "Current order status"
    },
    "createdAt": {
      "type": "string",
      "description": "ISO 8601 timestamp of order creation"
    }
  },
  "additionalProperties": false
}
